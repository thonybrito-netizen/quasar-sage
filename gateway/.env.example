# Direct Anthropic API key (preferred -- see app/clients/anthropic_client.py
# for why: Vertex AI's default quota for Anthropic models is 0 on a fresh
# GCP project and can't be self-served). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# Only used as a fallback if ANTHROPIC_API_KEY is unset.
VERTEX_PROJECT_ID=
VERTEX_REGION=global

CHAT_MODEL_ID=claude-sonnet-5

# JSON map of tenant_id -> bearer key. Generate real random keys before
# deploying -- these are placeholders.
TENANT_API_KEYS={"quietnoise":"REPLACE_ME_qns","lorito":"REPLACE_ME_col"}

MAX_INVISIBLE_RETRIES=2

# Comma-separated list, or "*" for dev.
CORS_ALLOW_ORIGINS=*
